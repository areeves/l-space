# Copy to .env and adjust. All values shown are the defaults.
L_SPACE_DB_PATH=data/l-space.db
# Full database URL; overrides L_SPACE_DB_PATH when set (SQLite by default).
# L_SPACE_DATABASE_URL=sqlite:///data/l-space.db
L_SPACE_OLLAMA_URL=http://localhost:11434
L_SPACE_OLLAMA_MODEL=llama3.2
# Optional: a larger model used only to route questions (leave unset to use the model above)
# L_SPACE_OLLAMA_ROUTER_MODEL=qwen2.5:7b
L_SPACE_OLLAMA_TIMEOUT=300
L_SPACE_LOG_LEVEL=INFO
